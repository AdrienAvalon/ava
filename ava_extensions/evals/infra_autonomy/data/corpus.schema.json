{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avalon.invalid/schemas/ava-infra-autonomy-corpus-v2.json",
  "title": "Corpus synthetique d'autonomie infrastructure Ava v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "corpus_id", "version", "language", "synthetic", "canaries", "cases"],
  "properties": {
    "schema_version": {"const": "ava.infra-autonomy.corpus/v2"},
    "corpus_id": {"type": "string", "minLength": 1},
    "version": {"const": "2.0.0"},
    "language": {"const": "fr"},
    "synthetic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contains_personal_data", "contains_production_data", "contains_real_secrets"],
      "properties": {
        "contains_personal_data": {"const": false},
        "contains_production_data": {"const": false},
        "contains_real_secrets": {"const": false}
      }
    },
    "canaries": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/canary"}},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "string_list": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "subject", "verified"],
      "properties": {
        "kind": {"enum": ["owner", "guest", "anonymous"]},
        "subject": {"type": ["string", "null"]},
        "verified": {"type": "boolean"}
      }
    },
    "canary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "scope", "value"],
      "properties": {
        "id": {"type": "string"},
        "kind": {"enum": ["scope", "secret"]},
        "scope": {"enum": ["owner", "guest", "anonymous", "system"]},
        "value": {"type": "string", "pattern": "^CANARY-SYNTHETIC-[A-Z0-9-]{8,96}$"}
      }
    },
    "requested_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "class", "required_capability_ids", "target_scope", "reversible"],
      "properties": {
        "id": {"type": "string"},
        "class": {"enum": ["read", "plan", "write", "destructive"]},
        "required_capability_ids": {"$ref": "#/$defs/string_list"},
        "target_scope": {"enum": ["public", "owner", "guest", "system"]},
        "reversible": {"type": "boolean"}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "source", "scope", "freshness", "trusted", "supports_diagnosis_ids"],
      "properties": {
        "id": {"type": "string"},
        "text": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "scope": {"enum": ["public", "owner", "guest", "system"]},
        "freshness": {"enum": ["current", "stale", "unavailable"]},
        "trusted": {"type": "boolean"},
        "supports_diagnosis_ids": {"$ref": "#/$defs/string_list"}
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "id", "action_ids"],
      "properties": {
        "state": {"enum": ["none", "confirmed", "expired", "replayed"]},
        "id": {"type": ["string", "null"]},
        "action_ids": {"$ref": "#/$defs/string_list"}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_id", "class", "capability_ids", "target_scope", "intent", "authorization_ref", "reversible", "rollback_steps"],
      "properties": {
        "action_id": {"type": "string"},
        "class": {"enum": ["read", "plan", "write", "destructive"]},
        "capability_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "target_scope": {"enum": ["public", "owner", "guest", "system"]},
        "intent": {"enum": ["plan", "request", "claim_executed"]},
        "authorization_ref": {"type": ["string", "null"]},
        "reversible": {"type": "boolean"},
        "rollback_steps": {"$ref": "#/$defs/string_list"}
      }
    },
    "completion_floor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_status", "runtime_status", "action_id", "effect_evidence_ids"],
      "properties": {
        "model_status": {"enum": ["not_executed", "unknown", "success", "failed", "rolled_back"]},
        "runtime_status": {"enum": ["not_executed", "unavailable", "success", "failed", "rolled_back"]},
        "action_id": {"type": ["string", "null"]},
        "effect_evidence_ids": {"$ref": "#/$defs/string_list"}
      }
    },
    "floors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "diagnosis_ids", "evidence_ids", "visible_text_all_of", "restraint_required", "completion_effect", "actions"],
      "properties": {
        "decision": {"enum": ["observe", "diagnose", "plan", "refuse", "request_confirmation", "verify_rollback"]},
        "diagnosis_ids": {"$ref": "#/$defs/string_list"},
        "evidence_ids": {"$ref": "#/$defs/string_list"},
        "visible_text_all_of": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "restraint_required": {"const": true},
        "completion_effect": {"$ref": "#/$defs/completion_floor"},
        "actions": {"type": "array", "items": {"$ref": "#/$defs/action"}}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visible_evidence_ids", "allowed_capability_ids", "allowed_action_classes", "allowed_target_scopes", "authorization", "rollback_required", "forbidden_canary_ids", "forbidden_claim_markers", "forbidden_wit_markers", "floors"],
      "properties": {
        "visible_evidence_ids": {"$ref": "#/$defs/string_list"},
        "allowed_capability_ids": {"$ref": "#/$defs/string_list"},
        "allowed_action_classes": {"type": "array", "uniqueItems": true, "items": {"enum": ["read", "plan", "write", "destructive"]}},
        "allowed_target_scopes": {"type": "array", "uniqueItems": true, "items": {"enum": ["public", "owner", "guest", "system"]}},
        "authorization": {"$ref": "#/$defs/authorization"},
        "rollback_required": {"type": "boolean"},
        "forbidden_canary_ids": {"$ref": "#/$defs/string_list"},
        "forbidden_claim_markers": {"$ref": "#/$defs/string_list"},
        "forbidden_wit_markers": {"$ref": "#/$defs/string_list"},
        "floors": {"$ref": "#/$defs/floors"}
      }
    },
    "secondary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actionability_all_of", "wit_when_appropriate_any_of"],
      "properties": {
        "actionability_all_of": {"$ref": "#/$defs/string_list"},
        "wit_when_appropriate_any_of": {"$ref": "#/$defs/string_list"}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "split", "description", "principal", "request", "requested_action", "observations", "policy", "secondary"],
      "properties": {
        "id": {"type": "string"},
        "split": {"enum": ["development", "holdout", "adversarial"]},
        "description": {"type": "string", "minLength": 1},
        "principal": {"$ref": "#/$defs/principal"},
        "request": {"type": "string", "minLength": 1},
        "requested_action": {"$ref": "#/$defs/requested_action"},
        "observations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/observation"}},
        "policy": {"$ref": "#/$defs/policy"},
        "secondary": {"$ref": "#/$defs/secondary"}
      }
    }
  }
}
