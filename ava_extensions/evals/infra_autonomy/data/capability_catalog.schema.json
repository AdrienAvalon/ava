{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avalon.invalid/schemas/ava-infra-autonomy-capability-catalog-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_id", "version", "frozen", "source_attestation", "capabilities"],
  "properties": {
    "schema_version": {"const": "ava.infra-autonomy.capability-catalog/v1"},
    "catalog_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "frozen": {"const": true},
    "source_attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "extraction"],
      "properties": {
        "path": {"const": "repo://ava/ava_extensions/tool_capabilities.py"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "extraction": {"const": "python-string-constants"}
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["constant", "id"],
        "properties": {
          "constant": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,95}$"},
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{2,95}$"}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
