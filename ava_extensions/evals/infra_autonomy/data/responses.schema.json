{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avalon.invalid/schemas/ava-infra-autonomy-responses-v2.json",
  "title": "Sorties modele et observations runtime synthetiques Ava",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "role", "evaluation_subject", "generation", "provenance", "prompt_sha256", "policy_sha256", "canonical_knowledge", "automatic_promotion", "responses"],
  "properties": {
    "schema_version": {"const": "ava.infra-autonomy.responses/v2"},
    "bundle_id": {"type": "string", "minLength": 1},
    "role": {"enum": ["negative_selftest", "positive_selftest", "release_reference", "candidate"]},
    "evaluation_subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "release_id", "release_sha256"],
      "properties": {
        "kind": {"enum": ["selftest", "release"]},
        "release_id": {"type": ["string", "null"]},
        "release_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "network", "tools", "memory", "traces"],
      "properties": {
        "mode": {"const": "synthetic-fixture"},
        "network": {"const": "disabled"},
        "tools": {"const": "disabled"},
        "memory": {"const": "disabled"},
        "traces": {"const": "disabled"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contains_personal_data", "contains_production_data", "contains_real_secrets"],
      "properties": {
        "contains_personal_data": {"const": false},
        "contains_production_data": {"const": false},
        "contains_real_secrets": {"const": false}
      }
    },
    "prompt_sha256": {"$ref": "#/$defs/sha256"},
    "policy_sha256": {"$ref": "#/$defs/sha256"},
    "canonical_knowledge": {"const": false},
    "automatic_promotion": {"const": false},
    "responses": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/response"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "subject", "verified"],
      "properties": {
        "kind": {"enum": ["owner", "guest", "anonymous"]},
        "subject": {"type": ["string", "null"]},
        "verified": {"type": "boolean"}
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "action_id", "evidence_refs"],
      "properties": {
        "status": {"enum": ["not_executed", "unknown", "success", "failed", "rolled_back"]},
        "action_id": {"type": ["string", "null"]},
        "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_id", "class", "capability_ids", "target_scope", "intent", "authorization_ref", "reversible", "rollback_steps"],
      "properties": {
        "action_id": {"type": "string"},
        "class": {"enum": ["read", "plan", "write", "destructive"]},
        "capability_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "target_scope": {"enum": ["public", "owner", "guest", "system"]},
        "intent": {"enum": ["plan", "request", "claim_executed"]},
        "authorization_ref": {"type": ["string", "null"]},
        "reversible": {"type": "boolean"},
        "rollback_steps": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "evidence_refs"],
      "properties": {
        "id": {"type": "string"},
        "text": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "model_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_text", "decision", "diagnosis_ids", "evidence_claims", "proposed_actions", "completion_claim"],
      "properties": {
        "raw_text": {"type": "string", "minLength": 1},
        "decision": {"enum": ["observe", "diagnose", "plan", "refuse", "request_confirmation", "verify_rollback"]},
        "diagnosis_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "evidence_claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
        "proposed_actions": {"type": "array", "items": {"$ref": "#/$defs/action"}},
        "completion_claim": {"$ref": "#/$defs/completion"}
      }
    },
    "runtime_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "status", "action_id", "observed_capability_ids", "effect_evidence_refs", "principal"],
      "properties": {
        "source": {"const": "synthetic-fixture"},
        "principal": {"$ref": "#/$defs/principal"},
        "status": {"enum": ["not_executed", "unavailable", "success", "failed", "rolled_back"]},
        "action_id": {"type": ["string", "null"]},
        "observed_capability_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "effect_evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "model_output", "runtime_observation"],
      "properties": {
        "case_id": {"type": "string"},
        "model_output": {"$ref": "#/$defs/model_output"},
        "runtime_observation": {"$ref": "#/$defs/runtime_observation"}
      }
    }
  }
}
