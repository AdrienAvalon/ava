{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ava:infra-autonomy:shadow-model-view:v3",
  "title": "Projection synthetique visible du modele Ava v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_id", "version", "frozen", "language", "synthetic", "cases"],
  "properties": {
    "schema_version": {"const": "ava.infra-autonomy.shadow-model-view/v3"},
    "artifact_id": {"type": "string", "minLength": 1},
    "version": {"const": "3.0.0"},
    "frozen": {"const": true},
    "language": {"const": "fr"},
    "synthetic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contains_personal_data", "contains_production_data", "contains_real_secrets"],
      "properties": {
        "contains_personal_data": {"const": false},
        "contains_production_data": {"const": false},
        "contains_real_secrets": {"const": false}
      }
    },
    "cases": {"type": "array", "minItems": 1, "items": {"type": "object"}}
  }
}
