{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ava:relationship:corpus:v1",
  "title": "Corpus relationnel synthetique Ava v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "corpus_id", "version", "language", "synthetic_only", "cases"],
  "properties": {
    "schema_version": {"const": "ava.relationship.corpus/v1"},
    "corpus_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$"},
    "version": {"type": "string", "minLength": 1},
    "language": {"const": "fr"},
    "synthetic_only": {"const": true},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonEmptyString"}
    },
    "stringGroups": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "indexArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0}
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$"},
        "text": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "split", "description", "principal", "conversation", "policy", "secondary"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,95}$"},
        "split": {"enum": ["development", "holdout", "adversarial"]},
        "description": {"$ref": "#/$defs/nonEmptyString"},
        "principal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["request_subject", "verified", "relationship_subject", "relationship_opt_in"],
          "properties": {
            "request_subject": {"type": "string", "pattern": "^synthetic:[a-z0-9._:-]+$"},
            "verified": {"type": "boolean"},
            "relationship_subject": {
              "oneOf": [
                {"type": "null"},
                {"type": "string", "pattern": "^synthetic:[a-z0-9._:-]+$"}
              ]
            },
            "relationship_opt_in": {"type": "boolean"}
          }
        },
        "conversation": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "content"],
            "properties": {
              "role": {"enum": ["user", "assistant"]},
              "content": {"$ref": "#/$defs/nonEmptyString"}
            }
          }
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowed_tools", "visible_facts", "forbidden_canaries", "allowed_memory_claim_ids"],
          "properties": {
            "allowed_tools": {"$ref": "#/$defs/stringArray"},
            "visible_facts": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
            "forbidden_canaries": {"$ref": "#/$defs/stringArray"},
            "allowed_memory_claim_ids": {"$ref": "#/$defs/stringArray"},
            "allowed_exact_echo_turn_indexes": {"$ref": "#/$defs/indexArray"}
          }
        },
        "secondary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["warmth_any_of", "wit_any_of", "continuity_all_of", "accuracy_all_of"],
          "properties": {
            "warmth_any_of": {"$ref": "#/$defs/stringArray"},
            "wit_any_of": {"$ref": "#/$defs/stringArray"},
            "continuity_all_of": {"$ref": "#/$defs/stringArray"},
            "continuity_any_of_groups": {"$ref": "#/$defs/stringGroups"},
            "accuracy_all_of": {"$ref": "#/$defs/stringArray"},
            "accuracy_any_of_groups": {"$ref": "#/$defs/stringGroups"},
            "required_secondary": {
              "type": "array",
              "uniqueItems": true,
              "items": {"enum": ["warmth", "wit", "continuity", "accuracy"]}
            }
          },
          "allOf": [
            {
              "not": {
                "required": ["continuity_all_of", "continuity_any_of_groups"],
                "properties": {
                  "continuity_all_of": {"minItems": 1},
                  "continuity_any_of_groups": {"minItems": 1}
                }
              }
            },
            {
              "not": {
                "required": ["accuracy_all_of", "accuracy_any_of_groups"],
                "properties": {
                  "accuracy_all_of": {"minItems": 1},
                  "accuracy_any_of_groups": {"minItems": 1}
                }
              }
            },
            {
              "if": {
                "required": ["required_secondary"],
                "properties": {"required_secondary": {"contains": {"const": "warmth"}}}
              },
              "then": {"properties": {"warmth_any_of": {"minItems": 1}}}
            },
            {
              "if": {
                "required": ["required_secondary"],
                "properties": {"required_secondary": {"contains": {"const": "wit"}}}
              },
              "then": {"properties": {"wit_any_of": {"minItems": 1}}}
            },
            {
              "if": {
                "required": ["required_secondary"],
                "properties": {"required_secondary": {"contains": {"const": "continuity"}}}
              },
              "then": {
                "anyOf": [
                  {"properties": {"continuity_all_of": {"minItems": 1}}},
                  {
                    "required": ["continuity_any_of_groups"],
                    "properties": {"continuity_any_of_groups": {"minItems": 1}}
                  }
                ]
              }
            },
            {
              "if": {
                "required": ["required_secondary"],
                "properties": {"required_secondary": {"contains": {"const": "accuracy"}}}
              },
              "then": {
                "anyOf": [
                  {"properties": {"accuracy_all_of": {"minItems": 1}}},
                  {
                    "required": ["accuracy_any_of_groups"],
                    "properties": {"accuracy_any_of_groups": {"minItems": 1}}
                  }
                ]
              }
            }
          ]
        }
      }
    }
  }
}
