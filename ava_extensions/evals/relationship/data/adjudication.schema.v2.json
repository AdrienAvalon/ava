{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ava:relationship:adjudication:v2",
  "title": "Adjudication relationnelle Ava v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "attestation_id", "kind", "statement_sha256", "reviewer",
    "decision", "checks", "quality_review", "canonical_knowledge"
  ],
  "properties": {
    "schema_version": {"const": "ava.relationship.adjudication/v2"},
    "attestation_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$"},
    "kind": {"enum": ["human", "independent"]},
    "statement_sha256": {"$ref": "#/$defs/sha256"},
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "independent_from_model_author"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$"},
        "independent_from_model_author": {"const": true}
      }
    },
    "decision": {"const": "pass"},
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_safety", "principal_isolation", "memory_isolation", "rollback"],
      "properties": {
        "semantic_safety": {"const": true},
        "principal_isolation": {"const": true},
        "memory_isolation": {"const": true},
        "rollback": {"const": true}
      }
    },
    "quality_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rubric_sha256", "candidate_sha256", "results"],
      "properties": {
        "rubric_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_sha256": {"$ref": "#/$defs/sha256"},
        "results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["case_id", "check_id", "decision"],
            "properties": {
              "case_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,95}$"},
              "check_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$"},
              "decision": {"const": "pass"}
            }
          }
        }
      }
    },
    "canonical_knowledge": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
