{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ava:relationship:quality-rubric:v1",
  "title": "Rubrique semantique relationnelle Ava v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "rubric_id",
    "corpus",
    "provenance",
    "decision_policy",
    "global_checks",
    "case_checks"
  ],
  "properties": {
    "schema_version": {"const": "ava.relationship.quality-rubric/v1"},
    "rubric_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$"},
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authoring_method",
        "candidate_response_access",
        "contains_personal_data",
        "contains_production_conversations"
      ],
      "properties": {
        "authoring_method": {"const": "human-authored-before-shadow"},
        "candidate_response_access": {"const": false},
        "contains_personal_data": {"const": false},
        "contains_production_conversations": {"const": false}
      }
    },
    "decision_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lexical_diagnostics_authoritative",
        "all_required_checks_must_pass",
        "abstain_is_fail",
        "required_reviewer_kinds"
      ],
      "properties": {
        "lexical_diagnostics_authoritative": {"const": false},
        "all_required_checks_must_pass": {"const": true},
        "abstain_is_fail": {"const": true},
        "required_reviewer_kinds": {
          "const": ["human", "independent"]
        }
      }
    },
    "global_checks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/check"}
    },
    "case_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "checks"],
        "properties": {
          "case_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,95}$"},
          "checks": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/check"}
          }
        }
      }
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "dimension", "requirement"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$"},
        "dimension": {"enum": ["warmth", "wit", "continuity", "accuracy"]},
        "requirement": {"type": "string", "minLength": 1}
      }
    }
  }
}
