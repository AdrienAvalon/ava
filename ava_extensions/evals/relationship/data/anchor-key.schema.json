{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ava:relationship:anchor-key:v1",
  "title": "Cle publique d'ancrage externe Ava v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "key_id", "algorithm", "public_key_base64", "canonical_knowledge"],
  "properties": {
    "schema_version": {"const": "ava.relationship.anchor-key/v1"},
    "key_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$"},
    "algorithm": {"const": "Ed25519"},
    "public_key_base64": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
    "canonical_knowledge": {"const": false}
  }
}
