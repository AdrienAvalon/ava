{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ava:relationship:responses:v1",
  "title": "Reponses hors ligne du banc relationnel Ava v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "corpus", "artifact", "responses"],
  "properties": {
    "schema_version": {"const": "ava.relationship.responses/v1"},
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "role", "source_kind", "generated_by", "engine", "prompt_sha256", "policy_sha256",
        "release_attestation_sha256", "release",
        "contains_personal_data", "contains_production_conversations", "canonical_knowledge"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "role": {"enum": ["baseline", "candidate"]},
        "source_kind": {"enum": ["synthetic_fixture", "offline_shadow"]},
        "generated_by": {"type": "string", "minLength": 1},
        "engine": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "model", "revision"],
          "properties": {
            "provider": {"type": "string", "minLength": 1},
            "model": {"type": "string", "minLength": 1},
            "revision": {"type": "string", "minLength": 1}
          }
        },
        "prompt_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "policy_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "release_attestation_sha256": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          ]
        },
        "release": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["repository", "git_sha", "adapter", "config_sha256", "manifest_sha256"],
              "properties": {
                "repository": {"type": "string", "pattern": "^repo:[A-Za-z0-9._:/+-]+$"},
                "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                "adapter": {"type": "string", "minLength": 1},
                "config_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                "manifest_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
              }
            }
          ]
        },
        "contains_personal_data": {"const": false},
        "contains_production_conversations": {"const": false},
        "canonical_knowledge": {"const": false}
      },
      "allOf": [
        {
          "if": {"properties": {"source_kind": {"const": "offline_shadow"}}},
          "then": {
            "properties": {
              "release_attestation_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "release": {"type": "object"}
            }
          },
          "else": {
            "properties": {
              "release_attestation_sha256": {"type": "null"},
              "release": {"type": "null"}
            }
          }
        }
      ]
    },
    "responses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "text", "applied_profile", "tool_calls", "memory_claims"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1, "maxLength": 24000},
          "applied_profile": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "subject"],
                "properties": {
                  "id": {"type": "string", "minLength": 1},
                  "subject": {"type": "string", "pattern": "^synthetic:[a-z0-9._:-]+$"}
                }
              }
            ]
          },
          "tool_calls": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name"],
              "properties": {"name": {"type": "string", "minLength": 1}}
            }
          },
          "memory_claims": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["fact_id", "text"],
              "properties": {
                "fact_id": {"type": "string", "minLength": 1},
                "text": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}
