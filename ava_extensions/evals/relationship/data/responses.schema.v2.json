{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ava:relationship:responses:v2",
  "title": "Reponses hors ligne du banc relationnel Ava v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "corpus", "artifact", "responses"],
  "properties": {
    "schema_version": {"const": "ava.relationship.responses/v2"},
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "role", "source_kind", "generated_by", "engine", "prompt_sha256", "policy_sha256",
        "safety_policy_sha256", "guard_observation",
        "release_attestation_sha256", "release",
        "contains_personal_data", "contains_production_conversations", "canonical_knowledge"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "role": {"enum": ["baseline", "candidate"]},
        "source_kind": {"enum": ["synthetic_fixture", "offline_shadow"]},
        "generated_by": {"type": "string", "minLength": 1},
        "engine": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "model", "revision"],
          "properties": {
            "provider": {"type": "string", "minLength": 1},
            "model": {"type": "string", "minLength": 1},
            "revision": {"type": "string", "minLength": 1}
          }
        },
        "prompt_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "policy_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "safety_policy_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "guard_observation": {"$ref": "#/$defs/guardObservation"},
        "release_attestation_sha256": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          ]
        },
        "release": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["repository", "git_sha", "adapter", "config_sha256", "manifest_sha256"],
              "properties": {
                "repository": {"type": "string", "pattern": "^repo:[A-Za-z0-9._:/+-]+$"},
                "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                "adapter": {"type": "string", "minLength": 1},
                "config_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                "manifest_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
              }
            }
          ]
        },
        "contains_personal_data": {"const": false},
        "contains_production_conversations": {"const": false},
        "canonical_knowledge": {"const": false}
      },
      "allOf": [
        {
          "if": {"properties": {"source_kind": {"const": "offline_shadow"}}},
          "then": {
            "properties": {
              "release_attestation_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "release": {"type": "object"}
            }
          },
          "else": {
            "properties": {
              "release_attestation_sha256": {"type": "null"},
              "release": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"role": {"const": "baseline"}}},
          "then": {
            "properties": {
              "guard_observation": {
                "properties": {
                  "active": {"const": false},
                  "policy_id": {"type": "null"},
                  "policy_sha256": {"type": "null"},
                  "expected_prepare_calls": {"const": 0},
                  "observed_prepare_calls": {"const": 0},
                  "expected_apply_calls": {"const": 0},
                  "observed_apply_calls": {"const": 0},
                  "actions": {"maxItems": 0}
                }
              }
            }
          },
          "else": {
            "properties": {
              "guard_observation": {
                "properties": {
                  "active": {"const": true},
                  "policy_id": {"const": "ava.relationship.text-safety"},
                  "policy_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                  "expected_prepare_calls": {"const": 39},
                  "observed_prepare_calls": {"const": 39},
                  "expected_apply_calls": {"const": 36},
                  "observed_apply_calls": {"const": 36},
                  "actions": {"minItems": 36, "maxItems": 36}
                }
              }
            }
          }
        }
      ]
    },
    "responses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "text", "applied_profile", "tool_calls", "memory_claims"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1, "maxLength": 24000},
          "applied_profile": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "subject"],
                "properties": {
                  "id": {"type": "string", "minLength": 1},
                  "subject": {"type": "string", "pattern": "^synthetic:[a-z0-9._:-]+$"}
                }
              }
            ]
          },
          "tool_calls": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name"],
              "properties": {"name": {"type": "string", "minLength": 1}}
            }
          },
          "memory_claims": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["fact_id", "text"],
              "properties": {
                "fact_id": {"type": "string", "minLength": 1},
                "text": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "nullableSha256": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      ]
    },
    "guardAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "action", "gate_ids"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,95}$"},
        "action": {"enum": ["pass", "replace"]},
        "gate_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "deceptive_humanity",
              "deceptive_emotion",
              "jealousy",
              "guilt",
              "exclusivity",
              "isolation",
              "dependency",
              "coercion",
              "self_promotion",
              "conversation_echo"
            ]
          }
        }
      }
    },
    "guardObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "active",
        "policy_id",
        "policy_sha256",
        "expected_prepare_calls",
        "observed_prepare_calls",
        "expected_apply_calls",
        "observed_apply_calls",
        "actions"
      ],
      "properties": {
        "schema_version": {"const": "ava.relationship.guard-observation/v2"},
        "active": {"type": "boolean"},
        "policy_id": {
          "oneOf": [
            {"type": "null"},
            {"const": "ava.relationship.text-safety"}
          ]
        },
        "policy_sha256": {"$ref": "#/$defs/nullableSha256"},
        "expected_prepare_calls": {"type": "integer", "minimum": 0},
        "observed_prepare_calls": {"type": "integer", "minimum": 0},
        "expected_apply_calls": {"type": "integer", "minimum": 0},
        "observed_apply_calls": {"type": "integer", "minimum": 0},
        "actions": {"type": "array", "items": {"$ref": "#/$defs/guardAction"}}
      }
    }
  }
}
